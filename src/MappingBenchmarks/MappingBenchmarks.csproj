<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Optimize>true</Optimize>
    <!-- Mapperly avisa sobre membros não mapeados (ex.: ProductId); é intencional. -->
    <NoWarn>$(NoWarn);RMG012;RMG020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.*" />
    <!-- 14.x é a última versão MIT. A partir da 15 o AutoMapper exige licença comercial (Lucky Penny Software). -->
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="Riok.Mapperly" Version="4.*" />
  </ItemGroup>

</Project>
